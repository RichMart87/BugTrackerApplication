# Anything prefixed VITE_ is compiled into the client bundle and visible to every
# visitor. Never put secrets in these files.

# Point the dev server proxy at a backend on a different host or port.
VITE_API_PROXY_TARGET=http://localhost:5174

# Optional: call an absolute API base instead of the same-origin /api proxy.
# VITE_API_BASE_URL=https://bugtracker.internal/api
